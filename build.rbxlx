      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">ShopTypes</string>
          <string name="Source"><![CDATA[local ShopTypes = {}

export type Category = "Gun" | "Melee" | "Armor"
export type Weight = "Light" | "Moderate" | "Heavy"

export type Pill = {
	Text: string,
	Color: Color3,
}

export type FilterInfo = {
	FilterType: string,
	Name: string,
	Order: number,
	Image: string?,
}

export type ShopInfo = {
	ShopName: string,
	Category: Category,
	Filters: { FilterInfo },
}

export type ArmorInfo = {
	BulletResistance: number,
	SharpResistance: number,
	BluntResistance: number,
	ArmorType: string,
}

export type MeleeInfo = {
	Damage: number,
	SwingDebounce: number,
	DamageType: string,
}

export type GunInfo = {
	FireType: "Auto" | "Semi" | "Burst",
	Damage: number,
	Firerate: number,
	Bullets: number,
	ZoomFOV: number,
	BulletSpeed: number,
	Spread: number,
	Range: number,
	ReloadTime: number,
	Recoil: number,
	HeadshotMultiplier: number,
	DamageType: string,
}

export type ItemInfo = ArmorInfo | MeleeInfo | GunInfo

export type WeaponInfo = {
	Name: string,
	Category: Category,
	Weight: Weight,
	Price: number,
	Level: number,
	Lore: string,
	SpecialText: string,
	GroupUnlocked: boolean,
	Consumable: boolean,
	MaxStack: number?,
	PreviewImage: string,
	ItemInfo: ItemInfo,
	Pills: { Pill },
}

export type ShopQuery = {
	category: Category?,
	weights: Weight | { Weight }?,
	nameContains: string?,
	search: string?,
	priceMin: number?,
	priceMax: number?,
	levelMin: number?,
	levelMax: number?,
	consumable: boolean?,
	groupUnlocked: boolean?,
	customFilters: { [string]: any }?,
	sortBy: string?,
	sortDir: "asc" | "desc"?,
	offset: number?,
	limit: number?,
	fields: { string }?,
	returnType: "map" | "array"?,
	name: string?,
}

return ShopTypes
]]></string>
