          <string name="Name">Bootstrapper</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local ServerScriptService = game:GetService("ServerScriptService")
local DataAPI = ServerScriptService:WaitForChild("DataAPI")
local Core = require(DataAPI.Core)
local Manager = require(DataAPI.Manager)
Core.start()
Manager.start()
]]></string>
