        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[local ShopUI = {}
ShopUI.__index = ShopUI

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GUIs = ReplicatedStorage:WaitForChild("GUIs")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local Remotes = ReplicatedStorage:WaitForChild("ShopRemotes")
local RemoteInfo = Remotes:WaitForChild("GetWeaponInfo")
local RemoteInfoAll = Remotes:WaitForChild("GetAllInfoForCategory")

local WeaponPreviews = ReplicatedStorage:WaitForChild("WeaponPreview")

local ShopInfos = ReplicatedStorage.ShopClient.ShopInfos
local ShopTypes = require(ReplicatedStorage.ShopClient.ShopTypes)

local Shops = workspace:WaitForChild("Shops")

type Category = ShopTypes.Category
type Weight = ShopTypes.Weight
type Pill = ShopTypes.Pill
type FilterInfo = ShopTypes.FilterInfo
type ShopInfo = ShopTypes.ShopInfo
type ArmorInfo = ShopTypes.ArmorInfo
type MeleeInfo = ShopTypes.MeleeInfo
type GunInfo = ShopTypes.GunInfo
type WeaponInfo = ShopTypes.WeaponInfo

local DAMAGE_TYPE_TO_COLOR = {
	Bullet = Color3.new(0.8, 0.8, 0.8),
	Special = Color3.new(1, 1, 0),
	Sharp = Color3.new(1, 0, 0),
	Blunt = Color3.new(1, 0.4, 0),
}

local SOUND_MAP = {
	Select = { SoundId = "rbxassetid://124033101073224" },
	Hover = { SoundId = "rbxassetid://139295675611093" },
	EndHover = { SoundId = "rbxassetid://139295675611093", PlaybackSpeed = 0.8, Volume = 0.3 },
	Purchase = { SoundId = "rbxassetid://134535509531927" },
	Error = { SoundId = "rbxassetid://8466981206" },
}

local CAMERA_MOUSE_INFLUENCE = 0.24
local CAMERA_LERP_ALPHA = 0.01
local PURCHASE_LOADING_DELAY = 1.5
local CURRENCY_ANIMATION_DURATION = 0.45

local function clamp01(value: number): number
	if value < 0 then
		return 0
	end
	if value > 1 then
		return 1
	end
	return value
end

local function normalized(value: number, minValue: number, maxValue: number): number
	if maxValue <= minValue then
		return 0
	end
	return clamp01((value - minValue) / (maxValue - minValue))
end

local function firerateToShotsPerSecond(firerate: number): number
	if firerate <= 0 then
		return 0
	end

	-- Support common formats:
	-- 1) rounds-per-minute values (usually >= 20)
	-- 2) seconds-per-shot values (usually < 1)
	-- 3) already shots-per-second values (everything else)
	if firerate >= 20 then
		return firerate / 60
	end

	if firerate < 1 then
		return 1 / firerate
	end

	return firerate
end

local function scoreZoomFOV(zoomFOV: number): number
	-- 20-40 is the strong/"decent" range, but sub-20 should still visibly register.
	if zoomFOV <= 20 then
		return normalized(zoomFOV, 0, 20) * 0.45
	end

	if zoomFOV <= 40 then
		return 0.45 + normalized(zoomFOV, 20, 40) * 0.45
	end

	return 0.9 + normalized(zoomFOV, 40, 55) * 0.1
end

local GUN_BASELINES = {
	Auto = {
		damage = { min = 10, max = 42 },
		firerate = { min = 3.5, max = 14 },
		dps = { min = 55, max = 300 },
		recoil = { min = 8, max = 48 },
		clip = { min = 18, max = 60 },
		reload = { min = 1.7, max = 3.8 },
	},
	Semi = {
		damage = { min = 18, max = 75 },
		firerate = { min = 1.6, max = 8 },
		dps = { min = 45, max = 260 },
		recoil = { min = 10, max = 55 },
		clip = { min = 6, max = 26 },
		reload = { min = 1.5, max = 3.4 },
	},
	Burst = {
		damage = { min = 14, max = 52 },
		firerate = { min = 2.4, max = 10.5 },
		dps = { min = 70, max = 320 },
		recoil = { min = 9, max = 52 },
		clip = { min = 12, max = 36 },
		reload = { min = 1.6, max = 3.6 },
	},
}

local function _getShopInfo(shopName: string): ShopInfo
	local info = ShopInfos:FindFirstChild(shopName)
	assert(info, "Missing shop info " .. shopName)
	return require(info)
end

local function _getWeaponInfo(weaponName: string): WeaponInfo?
	return RemoteInfo:InvokeServer(weaponName)
end

local function _getAllWeaponInfosForCategory(category: Category): { WeaponInfo }
	local infos = RemoteInfoAll:InvokeServer({ category = category })
	if not infos then
		warn("No info provided")
	end
	return infos or {}
end

local function _queryAllWeapons(queryTable): { WeaponInfo }
	local infos = RemoteInfoAll:InvokeServer(queryTable)
	if not infos then
		warn("No info provided")
	end
	return infos or {}
end

local function lockCamera()
	Camera.CameraType = Enum.CameraType.Scriptable
end

local function returnCamera()
	Camera.CameraType = Enum.CameraType.Custom
end

local function tweenCameraCFrame(newCFrame: CFrame)
	local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local tween = TweenService:Create(Camera, tweenInfo, { CFrame = newCFrame })
	tween:Play()
end

local function getCurrentMoney()
	local leaderstats = Player:WaitForChild("leaderstats")
	local Money = leaderstats:WaitForChild("Credits")
	return Money.Value
end

local function getCurrentLevel()
	local leaderstats = Player:WaitForChild("leaderstats")
	local Level = leaderstats:WaitForChild("Level")
	return Level.Value
end

local function shouldBeLocked(requiredLevel: number, requiredMoney: number): { isUnlocked: boolean, reason: string }
	local leaderstats = Player:WaitForChild("leaderstats")
	local Money = leaderstats:WaitForChild("Credits")
	local Level = leaderstats:WaitForChild("Level")

	local Reason = ""
	local Unlocked = true

	if Money.Value < requiredMoney then
		Reason = Reason .. "Money"
		Unlocked = false
	end

	if Level.Value < requiredLevel then
		Reason = Reason .. "Level"
		Unlocked = false
	end

	return { isUnlocked = Unlocked, reason = Reason }
end

function ShopUI.new(shopModelName: string)
	local Shop = Shops:FindFirstChild(shopModelName)
	if not Shop then
		warn(`No shop named {shopModelName} was found, could not create shop`)
		return
	end

	assert(Shop:FindFirstChild("ShopMusic"), "No shop music")
	assert(Shop:FindFirstChild("Shop"), "No shop model")
	assert(Shop:FindFirstChild("CameraPart"), "No camera part")

	local self = setmetatable({}, ShopUI)
	local shopGui = GUIs.Shop:Clone()
	shopGui.Parent = Player.PlayerGui
	self.shopInfo = _getShopInfo(shopModelName)
	self.gui = shopGui
	self.sounds = {}

	self.CameraPart = Shop.CameraPart
	self.ShopMusic = Shop.ShopMusic
	self.ShopMusic.Volume = 0.3

	self.ShopModel = Shop.Shop
	self.ShopName = shopModelName

	local UIFrame = self.gui.Main.UI
	local LoadingFrame = self.gui.Main.Loading
	local LoadingIcon = LoadingFrame.LoadingIcon

	local MenuOptions = UIFrame.MenuOptions.Options

	local WeaponInfo = UIFrame.WeaponInfo :: Frame
	local LoreBox = WeaponInfo.LoreBox :: Frame
	local PurchaseArea = WeaponInfo.PurchaseArea :: Frame
	local PurchaseButton = PurchaseArea.TextButton :: TextButton

	local WeaponPreview = UIFrame.WeaponPreview :: Frame
	local ViewportFrame = WeaponPreview.ViewportFrame :: ViewportFrame

	local WeaponSelection = UIFrame.WeaponSelection :: Frame
	local ScrollingFrame = WeaponSelection.ScrollingFrame :: ScrollingFrame
	local Filters = WeaponSelection.Filters :: Frame

	local WeaponStats = UIFrame.WeaponStats.Stats :: Frame
	local Bars = WeaponStats.Bars :: Frame
	local Pills = WeaponStats.Pills :: Frame
	local ExitButton = UIFrame.Exit :: TextButton
	local _CurrencyOwnedText = UIFrame.CurrencyOwned :: TextLabel
	local _Level = UIFrame.Level :: TextLabel

	self.LoadingFrame = LoadingFrame
	self.LoadingIcon = LoadingIcon

	self.MainFrame = UIFrame
	self.MenuOptions = MenuOptions
	self.WeaponInfo = WeaponInfo
	self.WeaponPreview = WeaponPreview
	self.WeaponSelection = WeaponSelection
	self.WeaponStats = WeaponStats

	self.LoreBox = LoreBox
	self.PurchaseArea = PurchaseArea
	self.PurchaseButton = PurchaseButton

	self.ViewportFrame = ViewportFrame

	self.ScrollingFrame = ScrollingFrame
	self.Filters = Filters

	self.Bars = Bars
	self.Pills = Pills
	self.Exit = ExitButton

	self.alive = false
	self.currentFilter = ""

	local previewCamera = Instance.new("Camera")
	previewCamera.CFrame = CFrame.new(Vector3.zero)
	self.ViewportFrame.CurrentCamera = previewCamera

	self.PreviewCamera = previewCamera
	self.previewConnection = nil
	self.previewModel = nil
	self.previewWorldModel = nil
	self.previewAngle = 0
	self.previewBasePivot = nil

	local colorCorrection = Instance.new("ColorCorrectionEffect", Camera)
	local blurEffect = Instance.new("BlurEffect", Camera)
	blurEffect.Size = 0
	colorCorrection.TintColor = Color3.new(1, 1, 1)

	self.blurEffect = blurEffect
	self.colorCorrection = colorCorrection

	self.MainFrame.Position = UDim2.new(0.5, 0, 2, 0)
	self.baseCameraCFrame = self.CameraPart.CFrame
	self.connection = nil
	self.purchaseConnection = nil
	self.currencyConnection = nil
	self.purchaseInProgress = false
	self.purchaseLoadingToken = 0
	self.currencyAnimationToken = 0
	self.currentCurrencyAmount = nil
	self.ownedItems = {}
	self.currentWeaponInfoButtons = {}
	self.currentWeaponName = nil

	self:Init()

	return self
end

function ShopUI:UpdateOwnedWeapons()
	local ownedItems = Remotes.GetOwnedItems:InvokeServer() :: { string }
	if not ownedItems then
		warn("No owned items provided")
		return
	end

	self.ownedItems = ownedItems
end

function ShopUI:UpdateCurrencyDisplay(targetAmount: number)
	local currencyText = self.MainFrame.CurrencyOwned :: TextLabel
	local currentAmount = self.currentCurrencyAmount

	if currentAmount == nil then
		self.currentCurrencyAmount = targetAmount
		currencyText.Text = "※ " .. tostring(targetAmount)
		return
	end

	self.currencyAnimationToken += 1
	local currencyAnimationToken = self.currencyAnimationToken
	local startAmount = currentAmount

	if targetAmount >= startAmount then
		self.currentCurrencyAmount = targetAmount
		currencyText.Text = "※ " .. tostring(targetAmount)
		return
	end

	task.spawn(function()
		local startTime = os.clock()
		local duration = CURRENCY_ANIMATION_DURATION

		while self.alive and self.currencyAnimationToken == currencyAnimationToken do
			local progress = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local easedProgress = 1 - (1 - progress) ^ 3
			local displayedAmount = math.floor(startAmount + (targetAmount - startAmount) * easedProgress + 0.5)

			self.currentCurrencyAmount = displayedAmount
			currencyText.Text = "※ " .. tostring(displayedAmount)

			if progress >= 1 then
				break
			end

			task.wait()
		end

		if self.currencyAnimationToken == currencyAnimationToken then
			self.currentCurrencyAmount = targetAmount
			currencyText.Text = "※ " .. tostring(targetAmount)
		end
	end)
end

function ShopUI:OwnsWeapon(weaponName: string): boolean
	return table.find(self.ownedItems, weaponName) ~= nil
end

function ShopUI:ResetWeaponFrameState(weaponFrame)
	local title = weaponFrame.Title :: TextLabel
	local cost = weaponFrame.Cost :: TextLabel
	local level = weaponFrame.Level :: TextLabel
	local image = weaponFrame.ImageLabel :: ImageLabel

	title.BackgroundColor3 = Color3.new(1, 1, 1)
	title.TextColor3 = Color3.new(1, 1, 1)
	cost.TextColor3 = Color3.new(1, 1, 1)
	level.TextColor3 = Color3.new(1, 1, 1)
	image.ImageColor3 = Color3.new(1, 1, 1)
	image.ImageTransparency = 0
end

function ShopUI:ApplyWeaponFrameState(weaponFrame, weaponInfo: WeaponInfo)
	self:ResetWeaponFrameState(weaponFrame)

	local title = weaponFrame.Title :: TextLabel
	local cost = weaponFrame.Cost :: TextLabel
	local level = weaponFrame.Level :: TextLabel
	local image = weaponFrame.ImageLabel :: ImageLabel

	if self:OwnsWeapon(weaponInfo.Name) then
		title.BackgroundColor3 = Color3.new(0.062745, 0.2, 0.062745)
		title.TextColor3 = Color3.new(0, 1, 0)
		cost.TextColor3 = Color3.new(0, 1, 0)
		level.TextColor3 = Color3.new(0, 1, 0)
		image.ImageColor3 = Color3.new(0, 1, 0)
		image.ImageTransparency = 0.5
		return
	else
		title.TextColor3 = Color3.new(0, 0, 0)
	end

	local result = shouldBeLocked(weaponInfo.Level, weaponInfo.Price)
	if result.isUnlocked then
		return
	end

	local reason = result.reason
	if reason == "MoneyLevel" then
		level.TextColor3 = Color3.new(1, 0, 0)
		cost.TextColor3 = Color3.new(1, 0, 0)
	elseif reason == "Money" then
		cost.TextColor3 = Color3.new(1, 0, 0)
	elseif reason == "Level" then
		level.TextColor3 = Color3.new(1, 0, 0)
	end

	image.ImageTransparency = 0.5
	title.BackgroundColor3 = Color3.new(1, 0, 0)
end

function ShopUI:ApplySelectedWeaponState(weaponInfo: WeaponInfo)
	self.PurchaseArea.Visible = true
	self.PurchaseButton.BackgroundColor3 = Color3.new(1, 1, 1)
	self.PurchaseButton.Text = "※ " .. weaponInfo.Price

	if self:OwnsWeapon(weaponInfo.Name) then
		self.PurchaseButton.Text = "OWNED"
		self.PurchaseButton.BackgroundColor3 = Color3.new(0.4, 0.4, 0.4)
		return
	end

	local result = shouldBeLocked(weaponInfo.Level, weaponInfo.Price)
	if result.isUnlocked then
		return
	end

	self.PurchaseButton.BackgroundColor3 = Color3.new(1, 0, 0)
	if result.reason == "MoneyLevel" then
		self.PurchaseButton.Text = "※ " .. weaponInfo.Price .. " | LVL " .. weaponInfo.Level
	elseif result.reason == "Money" then
		self.PurchaseButton.Text = "※ " .. weaponInfo.Price
	elseif result.reason == "Level" then
		self.PurchaseButton.Text = "LVL " .. weaponInfo.Level
	end
end

function ShopUI:ExitLoadingState()
	local backgroundTween = TweenService:Create(
		self.LoadingFrame,
		TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	)

	local iconTween = TweenService:Create(
		self.LoadingIcon,
		TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ ImageTransparency = 1 }
	)

	iconTween:Play()
	backgroundTween:Play()
end

function ShopUI:StartLoadingState()
	self.LoadingIcon.Position = UDim2.new(0.5, 0, 0.6, 0)
	self.LoadingIcon:TweenPosition(
		UDim2.new(0.5, 0, 0.5, 0),
		Enum.EasingDirection.Out,
		Enum.EasingStyle.Quint,
		0.4,
		true
	)

	local backgroundTween = TweenService:Create(
		self.LoadingFrame,
		TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 0.5 }
	)

	local iconTween = TweenService:Create(
		self.LoadingIcon,
		TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ ImageTransparency = 0 }
	)

	iconTween:Play()
	backgroundTween:Play()
end

function ShopUI:ClearWeaponPreview()
	if self.previewConnection then
		self.previewConnection:Disconnect()
		self.previewConnection = nil
	end

	if self.previewModel then
		self.previewModel:Destroy()
		self.previewModel = nil
	end

	if self.previewWorldModel then
		self.previewWorldModel:Destroy()
		self.previewWorldModel = nil
	end

	self.previewBasePivot = nil
	self.previewAngle = 0
	self.ViewportFrame:ClearAllChildren()
	self.ViewportFrame.CurrentCamera = self.PreviewCamera
end

function ShopUI:SetupWeaponPreview(weaponName: string)
	self:ClearWeaponPreview()

	local model = WeaponPreviews:FindFirstChild(weaponName)
	if not model then
		warn("No preview model", weaponName)
		return
	end
	if not model:IsA("Model") then
		warn("Not a model", weaponName)
		return
	end
	if not model.PrimaryPart then
		warn("No primary part for model", weaponName)
		return
	end

	local previewClone = model:Clone()
	previewClone:PivotTo(CFrame.new())

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = self.ViewportFrame
	previewClone.Parent = worldModel

	self.previewModel = previewClone
	self.previewWorldModel = worldModel
	self.previewBasePivot = previewClone:GetPivot()

	local _, boundsSize = previewClone:GetBoundingBox()
	local cameraDistance = math.max(boundsSize.X, boundsSize.Y + 0.3, boundsSize.Z) * 1.7 + 1.25
	self.PreviewCamera.CFrame =
		CFrame.new(Vector3.new(0, boundsSize.Y * 0.1, cameraDistance), Vector3.new(0, boundsSize.Y * 0.1, 0))

	self.previewConnection = RunService.RenderStepped:Connect(function(deltaTime)
		if not self.alive or not self.previewModel or not self.previewBasePivot then
			return
		end

		self.previewAngle += deltaTime * 0.6
		self.previewModel:PivotTo(self.previewBasePivot * CFrame.Angles(0, self.previewAngle, 0))
	end)
end

function ShopUI:LoadStats(weaponInfo: WeaponInfo)
	local weaponStats = self.WeaponStats :: Frame
	local Bars = weaponStats.Bars :: Frame
	local Pills = weaponStats.Pills :: Frame
	local BarRef = Bars.BarReference :: Frame
	local PillRef = Pills.PillReference :: Frame

	for _, barFrame in ipairs(Bars:GetChildren()) do
		if barFrame.Name ~= "BarReference" and barFrame:IsA("Frame") then
			barFrame:Destroy()
		end
	end

	for _, pillFrame in ipairs(Pills:GetChildren()) do
		if pillFrame:IsA("Frame") and pillFrame.Name ~= "PillReference" then
			pillFrame:Destroy()
		end
	end

	local function createBar(barLabel: string, fillLevel: number)
		local barFrame = BarRef:Clone() :: Frame
		local bar = barFrame.Bar :: Frame
		local fill = bar.Fill :: Frame
		local label = bar.Label :: TextLabel

		fillLevel = clamp01(fillLevel)
		label.Text = string.upper(barLabel)

		fill.Size = UDim2.new(0, 0, 1, 0)

		if fillLevel < 0.3 then
			fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
			label.TextColor3 = Color3.new(1, 0, 0)
		elseif fillLevel == 1 then
			fill.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
			label.TextColor3 = Color3.fromRGB(255, 255, 0)
		end

		barFrame.Name = barLabel
		barFrame.Visible = true
		barFrame.Parent = Bars
		fill:TweenSize(UDim2.new(fillLevel, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quint, 1, true)
	end

	local function createPill(pillText: string, color: Color3)
		local pill = PillRef:Clone() :: Frame
		local label = pill.Pill :: TextLabel
		label.Text = string.upper(pillText)
		label.BackgroundColor3 = color
		pill.BackgroundColor3 = Color3.new(color.R * 0.8, color.G * 0.8, color.B * 0.8)
		pill.Visible = true
		pill.Name = pillText
		pill.Parent = Pills
	end

	if weaponInfo.Category == "Gun" then
		local gunInfo = weaponInfo.ItemInfo :: GunInfo
		local baseline = GUN_BASELINES[gunInfo.FireType] or GUN_BASELINES.Auto
		local shotsPerSecond = firerateToShotsPerSecond(gunInfo.Firerate)
		local estimatedDPS = gunInfo.Damage * shotsPerSecond

		local rawDamageScore = normalized(gunInfo.Damage, baseline.damage.min, baseline.damage.max)
		local dpsDamageScore = normalized(estimatedDPS, baseline.dps.min, baseline.dps.max)
		local damageScore = clamp01(rawDamageScore * 0.4 + dpsDamageScore * 0.6)
		local rateScore = normalized(shotsPerSecond, baseline.firerate.min, baseline.firerate.max)

		-- Lower recoil handles better, so invert the normalized score.
		local handleScore = 1 - normalized(gunInfo.Recoil, baseline.recoil.min, baseline.recoil.max)

		-- Reward bigger clips and fast reloads, but punish the combo of tiny clip + slow reload.
		local clipScore = normalized(gunInfo.Bullets, baseline.clip.min, baseline.clip.max) * 0.55
			+ (1 - normalized(gunInfo.ReloadTime, baseline.reload.min, baseline.reload.max)) * 0.45

		if gunInfo.Bullets <= baseline.clip.min + 2 and gunInfo.ReloadTime >= baseline.reload.max - 0.2 then
			clipScore *= 0.75
		end

		local zoomScore = scoreZoomFOV(gunInfo.ZoomFOV)

		createBar("DMG", damageScore)
		createBar("RATE", rateScore)
		createBar("HANDLE", handleScore)
		createBar("CLIP", clipScore)
		createBar("ZOOM", zoomScore)

		local damageColor = DAMAGE_TYPE_TO_COLOR[gunInfo.DamageType] or Color3.new(1, 1, 0)
		createPill(gunInfo.DamageType, damageColor)
	else
		createBar("DMG", 0)
		createBar("RATE", 0)
		createBar("HANDLE", 0)
		createBar("CLIP", 0)
		createBar("ZOOM", 0)
	end

	for _, pill: Pill in ipairs(weaponInfo.Pills) do
		createPill(pill.Text, pill.Color)
	end
end

function ShopUI:SelectWeapon(weaponName: string)
	if self.purchaseInProgress then
		warn("Can't select weapon while purchase is in progress")
		self:PlaySound("Error")
		return
	end

	local weaponInfo = _getWeaponInfo(weaponName) :: WeaponInfo
	if not weaponInfo then
		warn("No weapon info", weaponName)
		return
	end

	self.currentWeaponName = weaponName

	self.LoreBox.TextLabel.Text = weaponInfo.Lore
	self.WeaponInfo.WeaponTitle.Text = weaponInfo.Name
	self.WeaponStats.SpecialText.Text = weaponInfo.SpecialText
	self:ApplySelectedWeaponState(weaponInfo)

	self:SetupWeaponPreview(weaponName)
	self:LoadStats(weaponInfo)
end

function ShopUI:SelectFilter(filterType: "Weight", filter)
	if self.currentFilter == filter then
		return
	end

	self.currentFilter = filter

	if filterType == "Weight" then
		local info = _queryAllWeapons({
			category = self.shopInfo.Category,
			weights = filter,
		})
		self:LoadWeaponInfos(info)
	else
		warn("unimplemented", filterType)
	end
end

function ShopUI:UpdateWeaponInfos()
	for _, infoFrame in ipairs(self.currentWeaponInfoButtons) do
		local title = infoFrame.Title :: TextLabel
		local weaponName = title.Text
		local weaponInfo = _getWeaponInfo(weaponName) :: WeaponInfo
		if not weaponInfo then
			warn("No weapon info", weaponName)
			continue
		end

		self:ApplyWeaponFrameState(infoFrame, weaponInfo)
	end
end

function ShopUI:LoadWeaponInfos(info: { WeaponInfo })
	local selectionReference = self.ScrollingFrame.Reference
	self.currentWeaponInfoButtons = {}

	-- remove existing frames
	for _, child in ipairs(self.ScrollingFrame:GetChildren()) do
		if child:IsA("TextButton") and child.Name ~= "Reference" then
			child:Destroy()
		end
	end

	for _, weaponInfo: WeaponInfo in ipairs(info) do
		local weaponTextButton = selectionReference:Clone() :: TextButton
		weaponTextButton.Visible = true
		table.insert(self.currentWeaponInfoButtons, weaponTextButton)

		local DisplayImage = weaponTextButton.ImageLabel :: ImageLabel
		local Cost = weaponTextButton.Cost :: TextLabel
		local Level = weaponTextButton.Level :: TextLabel
		local Title = weaponTextButton.Title :: TextLabel
		weaponTextButton.Name = weaponInfo.Name

		DisplayImage.Image = weaponInfo.PreviewImage
		Title.Text = weaponInfo.Name
		Level.Text = "LVL " .. weaponInfo.Level
		Cost.Text = "※ " .. weaponInfo.Price
		weaponTextButton.Parent = self.ScrollingFrame

		self:ApplyWeaponFrameState(weaponTextButton, weaponInfo)

		weaponTextButton.MouseButton1Down:Connect(function()
			self:SelectWeapon(weaponInfo.Name)
		end)

		self:HookBaseButtonSounds(weaponTextButton, 0.04)
	end
end

function ShopUI:LoadFilters()
	local filterReference = self.Filters.FilterReference
	warn("Filter info:", self.shopInfo.Filters)
	for _, filter: FilterInfo in ipairs(self.shopInfo.Filters) do
		local filterFrame = filterReference:Clone()
		local imageButton = filterFrame:WaitForChild("ImageButton") :: ImageButton
		imageButton.Image = filter.Image

		filterFrame.Name = filter.Name
		filterFrame.LayoutOrder = filter.Order
		filterFrame.Visible = true
		filterFrame.Parent = self.Filters

		imageButton.MouseButton1Down:Connect(function()
			for _, button in ipairs(filterFrame.Parent:GetChildren()) do
				if button:IsA("Frame") then
					local imageButton = button:FindFirstChild("ImageButton")
					if imageButton then
						imageButton.ImageColor3 = Color3.new(1, 1, 1)
					end
				end
			end

			self:SelectFilter(filter.FilterType, filter.Name)
			imageButton.ImageColor3 = Color3.new(0.533333, 0.533333, 0.533333)
		end)
	end
end

function ShopUI:HookBaseButtonSounds(button: TextButton | ImageButton, scaleModifierAmount: number?)
	local scaleModifier = Instance.new("UIScale", button)

	button.MouseEnter:Connect(function()
		if not self.alive then
			return
		end
		TweenService:Create(
			scaleModifier,
			TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ Scale = 1 + (scaleModifierAmount or 0.07) }
		):Play()

		self:PlaySound("Hover")
	end)

	button.MouseLeave:Connect(function()
		if not self.alive then
			return
		end
		TweenService
			:Create(scaleModifier, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Scale = 1 })
			:Play()

		self:PlaySound("EndHover")
	end)

	button.MouseButton1Down:Connect(function()
		if not self.alive then
			return
		end
		self:PlaySound("Select")
	end)
end

function ShopUI:PlaySound(soundName: string)
	local sound = self.sounds[soundName]
	if not sound then
		warn(`No sound named {soundName} was found`)
		return
	end

	sound:Play()
end

function ShopUI:LoadSounds()
	for soundName, propertyList in pairs(SOUND_MAP) do
		local newSound = Instance.new("Sound", workspace)
		newSound.Name = soundName .. "UI"

		for propertName, _ in pairs(propertyList) do
			newSound[propertName] = propertyList[propertName]
		end

		self.sounds[soundName] = newSound
	end
end

function ShopUI:PurchaseCurrentItem()
	if not self.alive then
		return
	end

	local selectedWeaponName = self.currentWeaponName or self.WeaponInfo.WeaponTitle.Text
	local weaponInfo = _getWeaponInfo(selectedWeaponName)
	if not weaponInfo then
		warn("No weapon info for", selectedWeaponName)
		return
	end

	local isOwned = self:OwnsWeapon(selectedWeaponName)
	if isOwned then
		warn("Purchase failed:", "Already owned")
		self:PlaySound("Error")
		return
	end

	-- We can initially validate it ourselves
	local result = shouldBeLocked(weaponInfo.Level, weaponInfo.Price)
	if not result["isUnlocked"] then
		warn("Purchase failed:", "Not unlocked")
		self:PlaySound("Error")
		return
	end

	if self.purchaseInProgress then
		warn("Purchase failed:", "Already purchasing")
		self:PlaySound("Error")
		return
	end

	self.purchaseLoadingToken += 1
	local purchaseLoadingToken = self.purchaseLoadingToken

	local function endPurchase()
		self.PurchaseButton.BackgroundColor3 = Color3.new(1, 1, 1)
		self.purchaseInProgress = false
		self.purchaseLoadingToken += 1
		self:ExitLoadingState()
	end

	self.PurchaseButton.BackgroundColor3 = Color3.new(0.4, 0.4, 0.4)
	self.purchaseInProgress = true

	task.delay(PURCHASE_LOADING_DELAY, function()
		if not self.purchaseInProgress then
			return
		end

		if self.purchaseLoadingToken ~= purchaseLoadingToken then
			return
		end

		self:StartLoadingState()
	end)

	-- Our own validation passed, let's see if the server agrees
	local success, message = Remotes.RequestPurchase:InvokeServer(selectedWeaponName)
	if not success then
		warn("Purchase failed:", message)
		self:PlaySound("Error")
		endPurchase()
		return
	end

	self:PlaySound("Purchase")
	endPurchase()
end

function ShopUI:InitButtons()
	self.Exit.MouseButton1Down:Connect(function()
		if self.purchaseInProgress then
			warn("Can't exit while purchase is in progress")
			self:PlaySound("Error")
			return
		end
		self:Hide(true)
	end)

	for _, desc in ipairs(self.MainFrame:GetDescendants()) do
		if desc:IsA("TextButton") or desc:IsA("ImageButton") then
			self:HookBaseButtonSounds(desc)
		end
	end

	self.PurchaseButton.MouseButton1Down:Connect(function()
		self:PurchaseCurrentItem()
	end)
end

function ShopUI:InitLoadingScreen()
	local rotationTween = TweenService:Create(
		self.LoadingIcon,
		TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
		{ Rotation = 360 }
	)
	rotationTween:Play()
end

function ShopUI:Init()
	self:UpdateCurrencyDisplay(getCurrentMoney())
	self.MainFrame.Level.Text = "LVL " .. tostring(getCurrentLevel())
	self:LoadFilters()
	self:LoadSounds()
	self:InitButtons()
	self:InitLoadingScreen()
	self:SetupRenderConnect()
	self:ListenForPurchase()
	self:UpdateOwnedWeapons()
	self:Show(true)

	_getAllWeaponInfosForCategory(self.shopInfo.Category)
	self:SelectFilter(self.shopInfo.Filters[1].FilterType, self.shopInfo.Filters[1].Name)
end

function ShopUI:ListenForPurchase()
	if self.purchaseConnection then
		self.purchaseConnection:Disconnect()
	end

	if self.currencyConnection then
		self.currencyConnection:Disconnect()
	end

	local leaderstats = Player:WaitForChild("leaderstats")
	local credits = leaderstats:WaitForChild("Credits") :: NumberValue
	self.currencyConnection = credits:GetPropertyChangedSignal("Value"):Connect(function()
		self:UpdateCurrencyDisplay(credits.Value)
	end)

	self.purchaseConnection = Remotes.ItemPurchased.OnClientEvent:Connect(function(weaponName)
		self:UpdateOwnedWeapons()
		self:UpdateWeaponInfos()

		if self.currentWeaponName == weaponName then
			self:SelectWeapon(weaponName)
		end
	end)
end

function ShopUI:SetupRenderConnect()
	if self.connection then
		self.connection:Disconnect()
	end

	self.connection = RunService.RenderStepped:Connect(function()
		if not self.alive or Camera.CameraType ~= Enum.CameraType.Scriptable then
			return
		end

		local viewportSize = Camera.ViewportSize
		if viewportSize.X <= 0 or viewportSize.Y <= 0 then
			return
		end

		local mouse = UserInputService:GetMouseLocation()
		local normalizedX = ((mouse.X / viewportSize.X) - 0.5) * 2
		local normalizedY = ((mouse.Y / viewportSize.Y) - 0.5) * 2

		local rightOffset = normalizedX * CAMERA_MOUSE_INFLUENCE
		local upOffset = -normalizedY * CAMERA_MOUSE_INFLUENCE

		local targetCFrame = self.baseCameraCFrame * CFrame.new(rightOffset, upOffset, 0)
		Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, CAMERA_LERP_ALPHA)
	end)
end

function ShopUI:Show(entering: boolean)
	self.alive = true

	if entering then
		lockCamera()
		self.baseCameraCFrame = self.CameraPart.CFrame
		tweenCameraCFrame(self.CameraPart.CFrame)
		self.ShopMusic:Play()
		Player:SetAttribute("InShop", true)
	end

	self:TweenBlur(24)
	self:TweenTintColor(Color3.new(0.647059, 0.647059, 0.647059))

	local main = self.MainFrame :: Frame
	main:TweenPosition(UDim2.new(0.5, 0, 0.5, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quint, 1.5, true)
end

function ShopUI:Hide(exitting: boolean)
	self.alive = false
	local main = self.MainFrame :: Frame

	if exitting then
		returnCamera()
		TweenService
			:Create(self.ShopMusic, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Volume = 0 })
			:Play()
		Player:SetAttribute("InShop", false)
	end

	self:TweenBlur(0)
	self:TweenTintColor(Color3.new(1, 1, 1))

	main:TweenPosition(UDim2.new(0.5, 0, 2, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quint, 1, true, function()
		if exitting then
			task.delay(3, function()
				self:Destroy()
			end)
		end
	end)
end

function ShopUI:TweenBlur(newSize)
	if not self.blurEffect then
		return
	end
	TweenService
		:Create(
			self.blurEffect,
			TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{ Size = newSize }
		)
		:Play()
end

function ShopUI:TweenTintColor(newColor: Color3)
	if not self.colorCorrection then
		return
	end
	TweenService:Create(
		self.colorCorrection,
		TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ TintColor = newColor }
	):Play()
end

function ShopUI:Destroy()
	self:ClearWeaponPreview()

	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end

	if self.purchaseConnection then
		self.purchaseConnection:Disconnect()
		self.purchaseConnection = nil
	end

	if self.currencyConnection then
		self.currencyConnection:Disconnect()
		self.currencyConnection = nil
	end

	self.currencyAnimationToken += 1

	self.blurEffect:Destroy()
	self.colorCorrection:Destroy()
	self.gui:Destroy()

	for _, sound in pairs(self.sounds) do
		sound:Destroy()
	end
end

return ShopUI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">DataAPI</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">API</string>
          <string name="Source"><![CDATA[--[[------------------------------------------------------------------------------------
   	
   DATASTORE API MODULE
   
   @module API
   @author mezz_inc
   @description Provides the toplevel control for the dataAPI system
   
   @within ServerScriptService/DataAPI
   
   
   Initialization
   
]]
------------------------------------------------------------------------------------

local Module = {}

--- Name of the module
local NAME: string = "API"

local Players = game:GetService("Players")

--- Access the Data API folder
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DatastoreRep = ReplicatedStorage:WaitForChild("Datastore")
local DataAPI = ServerScriptService:WaitForChild("DataAPI")

Module._meta = {
	name = NAME,
	version = "1.0.0",
	description = "Top-level control of the DataAPI with player-centric functionality",
}

--[[----------------------------------------------------------------------------------

	Modules

]]
----------------------------------------------------------------------------------

--- Dependant modules
local Core = require(DataAPI.Core)
local Debug = require(DataAPI.Debug)
local Types = require(DataAPI.Types)
local Schema = require(DataAPI.Schema)

--[[----------------------------------------------------------------------------------

	Types

]]
----------------------------------------------------------------------------------

export type ErrorType = Types.ErrorType
export type Store = Types.Store
export type ValidDatastoreEntryTypes = Types.ValidDatastoreEntryTypes
export type ValidDatastoreKey = Types.ValidDatastoreKey
export type ValidDatastoreValue = Types.ValidDatastoreValue
export type ValidPlayer = Types.ValidPlayer
export type ValidStores = Types.ValidStores
export type PlayerRank = Types.PlayerRanks

--[[----------------------------------------------------------------------------------

	Debug
	Mostly wrapper functions for the Debug module

]]
----------------------------------------------------------------------------------

--- The source name of the module for debugging
local SOURCE_NAME: string = `[DataAPI.{NAME}]`

--- Prints out a debug message if debug is enabled
--- @param ... any? a variable number of arguments to prin
local function debugPrint(...)
	Debug.debugPrint(SOURCE_NAME, ...)
end

--- Warn a statement to the output
--- @param ... string? a variable number of strings/types to print
local function debugWarn(...)
	Debug.debugWarn(SOURCE_NAME, ...)
end

--- Raise an error to the output
--- @param ... string? a variable number of strings/types to print
------------------------- Module

--[[----------------------------------------------------------------------------------

	LOCAL FUNCTIONS
	
]]
----------------------------------------------------------------------------------

local function yieldToLoad()
	--- not debug warn as this is for YOU buddy
	if not Core.isLoaded() then
		warn("Attempt to access the Data API too early - yielding until fully loaded")

		while not Core.isLoaded() do
			task.wait(0.5)
		end
	end
end

--- Returns whether a store should be served through the player's data folder.
--- @param storeName ValidStores the store to check
--- @return boolean served whether the store is hot-served
local function storeIsServed(storeName: ValidStores): boolean
	return Schema.isServedStore(storeName)
end

--- Checks if a player is in the server
--- @param playerId number the id of the player to check
--- @return boolean if the player is in the server
local function playerInServer(playerId: number): boolean
	if script:GetAttribute("pretendPlayersDontExist") then
		return false
	end
	local Player = Players:GetPlayerByUserId(playerId) :: Player?

	if Player then
		--- might as well get the datastore at this point, they're not even loaded
		local dataFolder = Player:FindFirstChild("Data")
		if not dataFolder then
			return false
		end
	end
	return Player ~= nil
end

--- Returns a safe UserId from a player
--- @param Player ValidPlayer the player to get the UserId of
--- @return number the UserId of the player
local function getSafeUserId(Player: ValidPlayer): number
	if type(Player) == "number" then
		return Player
	elseif typeof(Player) == "Instance" then
		if not Player:IsA("Player") then
			warn(`Provided argument cannot be converted into a UserId - Type: {Player.ClassName or "nil"}`)
			return 0
		else
			return Player.UserId
		end
	elseif typeof(Player) == "string" then
		--- Player username
		if Players:FindFirstChild(Player) then
			return Players[Player].UserId
		else
			--- Is an ID just a string
			local isNumber = tonumber(Player)
			if not isNumber then
				warn(`Provided string argument cannot be converted into a UserId or username - {Player}`)
				return 0
			else
				return isNumber
			end
		end
	else
		warn(`Provided argument cannot be converted into a UserId - Type: {typeof(Player)}`)
		return 0
	end
end

--- Returns the store object from the store name
--- @param Player ValidPlayer the player to get the UserId of
--- @param storeName ValidStores the name of the store to get
--- @return entry ValidDatastoreEntryTypes the data
local function getPlayerEntry(Player: ValidPlayer, storeName: ValidStores)
	local store = Core.getStore(storeName)
	local playerId = getSafeUserId(Player)
	local _, result = store:GetEntry(playerId)
	return result
end

--- Overwrites a player's data for a storename entirely - primarily used for ordered datastores
--- Avoid using for flat stores
--- @param Player ValidPlayer the player to get the UserId of
--- @param storeName ValidStores the name of the store to set the data in
--- @param newData any the data to set the store to
--- @return success boolean whether it was able to be done
local function setPlayerEntry(Player: ValidPlayer, storeName: ValidStores, newData: any): boolean
	local store = Core.getStore(storeName)
	local playerId = getSafeUserId(Player)
	return store:SetEntry(playerId, newData)
end

--- Sets a new value for a key in a store
--- @param Player ValidPlayer the player to get the UserId of
--- @param storeName ValidStores the name of the store to set the data in
--- @param dataKey string the key of the data to set
--- @param newDataValue any the value to set the key to
--- @return success boolean whether it succeded
local function setPlayerEntryData(
	Player: ValidPlayer,
	storeName: ValidStores,
	dataKey: string,
	newDataValue: ValidDatastoreValue
): boolean
	local playerId = getSafeUserId(Player)
	local store = Core.getStore(storeName)
	local entry = getPlayerEntry(playerId, storeName)

	if not entry then
		warn(`Missing store name or key. Key: {playerId}, storeName: {storeName}`)
		return false
	end

	if entry[dataKey] == nil then
		warn(`Key {dataKey} is not a valid key for the entry`)
		return false
	end

	entry[dataKey] = newDataValue
	return store:SetEntry(playerId, entry) :: boolean
end

--- Attempts to increment a datastore value
--- @param Player ValidPlayer the player to get the UserId of
--- @param storeName ValidStores the name of the store to set the data in
--- @param dataKey string the key of the data to increment
--- @param incrementAmount number the amount to increment by
--- @return currentNumber number the current value of the datastore or 0 if failed
local function incrementPlayerEntryData(
	Player: ValidPlayer,
	storeName: ValidStores,
	dataKey: string,
	incrementAmount: number
): number
	local playerId = getSafeUserId(Player)
	local store = Core.getStore(storeName)
	local entry = getPlayerEntry(playerId, storeName)

	if entry[dataKey] == nil then
		warn(`Key {dataKey} is not a valid key for the entry`)
		return 0
	end

	-- Verify this is a number first of all
	local result = entry[dataKey]
	if type(result) ~= "number" then
		warn(`Attempt to increment key {dataKey} even though it's not a number - no change done`)
		return 0
	end

	local currentAmount = result + incrementAmount
	entry[dataKey] = currentAmount

	local success = store:SetEntry(playerId, entry)
	if not success then
		return 0
	end

	return currentAmount
end

--[[----------------------------------------------------------------------------------

	LIVE STATS
	Frequently updated information (lingo being stat)
	Stats should not constantly write to datastores when changed, so it's done
	via instances instead
	
]]
----------------------------------------------------------------------------------

--- Attempts to retrieve a player's Data folder in their player instance
--- Player must be in server
--- @param userId number the id of the player to get the folder of
--- @return DataFolder Folder the Data folder of the player
local function getPlayerDataFolder(userId: number): Folder?
	local Player = Players:GetPlayerByUserId(userId)
	if not Player then
		warn(`Provided ID {userId} is not in the server or not fully loaded`)
		return nil
	end

	local Data = Player:FindFirstChild("Data") :: Instance?
	return Data
end

--- Attempts to get a store folder from a player's Data folder
--- @param userId number the id of the player to get the folder of
--- @param storeName ValidStores the name of the store to get
--- @return store Folder the store folder
local function getPlayerDataFolderStore(userId: number, storeName: ValidStores): Folder?
	local dataFolder = getPlayerDataFolder(userId)
	if not dataFolder then
		warn("Could not get the data folder for provided player:", userId)
		return nil
	end

	local store = dataFolder:FindFirstChild(storeName, true)
	if not store then
		--- Early store access will yield
		for _ = 1, 4 do
			store = dataFolder:FindFirstChild(storeName, true)
			if store then
				return store
			end
			task.wait(1)
		end

		warn(`Could not find store name "{storeName}" in player's data folder`)
		return nil
	end

	return store
end

--- Attempts to get a stat instance from a player's Data folder
--- @param Player ValidPlayer a player id or object
--- @param storeName ValidStores the name of the store to get
--- @param statName string the name of the stat to get
--- @return stat ValueBase? the stat instance
local function getStatInstance(Player: ValidPlayer, storeName: ValidStores, statName: string): ValueBase | nil
	local userId = getSafeUserId(Player)

	local store = getPlayerDataFolderStore(userId, storeName) :: Folder?
	if not store then
		return nil
	end

	local statValue = store:FindFirstChild(statName) :: ValueBase?
	if not statValue then
		warn(`Could not find value "{statName}" in player's data folder for store {storeName}`)
		return nil
	end

	return statValue
end

--- Attempts to set a player's stat in the server
--- @param Player ValidPlayer a player id or object
--- @param storeName ValidStores the name of the store to get
--- @param statName string the name of the stat to set
--- @param statValue ValidDatastoreEntryTypes the value to set the stat to
--- @return success whether it succeded in changing the value
local function setPlayerStat(
	Player: ValidPlayer,
	storeName: ValidStores,
	statName: string,
	statValue: ValidDatastoreEntryTypes
): boolean
	local value = getStatInstance(Player, storeName, statName) :: ValueBase
	if not value then
		return false
	end
	value.Value = statValue
	return true
end

--- Adds a certain amount to a specific stat for a player in the server
--- @param Player ValidPlayer a player id or object
--- @param storeName ValidStores the name of the store to get
--- @param statName string the name of the stat to set
--- @param incrementNumber number the amount to add to the current stat value
--- @return amount number the new amount, 0 if not found
local function incrementPlayerStat(
	Player: ValidPlayer,
	storeName: ValidStores,
	statName: string,
	incrementNumber: number
): number
	local value = getStatInstance(Player, storeName, statName) :: ValueBase
	if not value then
		return 0
	end

	local newAmount = value.Value + incrementNumber
	value.Value = newAmount
	return newAmount
end

--[[----------------------------------------------------------------------------------

	NEWEST FUNCTIONS
	These are the data grabbers. Their main purpose is to check if the player
	we're trying to get the data of IS in the server.
	
	If they are in the server, we're going to check their stat folder, not their datastore.
	If they aren't, we do their datastore. Simple, no?
	
]]
----------------------------------------------------------------------------------

--- Returns the most recent store entry for a player
--- If the player shares the server with the current, it returns that store
--- Otherwise it returns the store from the datastore itself
--- @param Player ValidPlayer player id or object
--- @param storeName ValidStores the name of the store to get
local function getNewestEntry(Player: ValidPlayer, storeName: ValidStores)
	yieldToLoad()
	local userId = getSafeUserId(Player)
	local isInServer = playerInServer(userId)

	if isInServer then
		debugPrint(`Player {Player} is in the server - getting stat folder`)

		if not storeIsServed(storeName) then
			debugPrint(`Store {storeName} is cold-only - getting datastore`)
			return getPlayerEntry(Player, storeName)
		end

		local store = getPlayerDataFolderStore(userId, storeName)
		if not store then
			return getPlayerEntry(Player, storeName)
		end

		--- Ordered ones
		if not store:IsA("Folder") then
			return store.Value
		end

		local instances = store:GetChildren()
		--print(store, instances)
		return Schema.instancesToTable(instances)
	else
		debugPrint(`Player {Player} is not in the server - getting datastore`)

		--- Get datastore information
		return getPlayerEntry(Player, storeName)
	end
end

--- Attempts to update the most recent entry data for a player
--- If the player shares the server with the current, it updates their stat folder
--- Otherwise it updates the store in the datastore itself
--- @param Player ValidPlayer player id or object
--- @param storeName ValidStores the name of the store to get
--- @param keyName string the name of the key to update
--- @param newData any the new data to update the key with
--- @return success whether it was able to alter the data
local function updateNewestEntryData(Player: ValidPlayer, storeName: ValidStores, keyName: string, newData: any)
	yieldToLoad()

	local userId = getSafeUserId(Player)
	local isInServer = playerInServer(userId)
	local servedStore = storeIsServed(storeName)

	if isInServer and servedStore then
		debugPrint(`Player {Player} is in the server - updating stat folder`)

		--- Update stat information
		return setPlayerStat(Player, storeName, keyName, newData)
	else
		debugPrint(`Player {Player} is not in the server - updating datastore`)

		--- Update datastore information
		return setPlayerEntryData(Player, storeName, keyName, newData)
	end
end

--- Returns a specific piece of data from a player's most recent store
--- @param Player ValidPlayer player id or object
--- @param storeName ValidStores the name of the store to get
--- @param keyName string the name of the key to get
--- @return value any the value of the data if it exists
local function getNewestEntryData(Player: ValidPlayer, storeName: ValidStores, keyName: string)
	yieldToLoad()

	local tableEntry = getNewestEntry(Player, storeName)
	if not tableEntry then
		return nil
	end

	if tableEntry[keyName] == nil then
		debugWarn(`{keyName} is missing from the entry {storeName}`)
		return nil
	end

	return tableEntry[keyName]
end

--- Updates a number value in a player's most recent store
--- @param Player ValidPlayer player id or object
--- @param storeName ValidStores the name of the store to get
--- @param newData string the name of the key to update
--- @return success whether it was able to alter the data
local function updateNewestOrderedEntry(Player: ValidPlayer, storeName: ValidStores, newData: number): boolean
	yieldToLoad()

	local userId = getSafeUserId(Player)
	local isInServer = playerInServer(userId)

	if isInServer then
		debugPrint(`Player {Player} is in the server - updating stat folder`)

		local value = getPlayerDataFolderStore(userId, storeName)
		if not value or not value:IsA("ValueBase") then
			warn("No value for the ordered data was found - are you sure it IS an ordered data store?")
			return false
		end

		value.Value = newData

		return true
	else
		debugPrint(`Player {Player} is not in the server - updating datastore`)

		return setPlayerEntry(Player, storeName, newData)
	end
end

--- Increments a number value in a player's most recent store, 0 if failed
--- @param Player ValidPlayer player id or object
--- @param storeName ValidStores the name of the store to get
--- @param newAmount number the amount to increment the data by
--- @return amount number the new amount
local function incrementNewestOrderedEntry(Player: ValidPlayer, storeName: ValidStores, newAmount: number): number
	yieldToLoad()

	local userId = getSafeUserId(Player)
	local isInServer = playerInServer(userId)

	if isInServer then
		debugPrint(`Player {Player} is in the server - updating stat folder`)

		local value = getPlayerDataFolderStore(userId, storeName)
		if not value or not value:IsA("ValueBase") then
			warn("No value for the ordered data was found - are you sure it IS an ordered data store?")
			return 0
		end

		local curAmount = value.Value
		value.Value = curAmount + newAmount

		return value.Value
	else
		debugPrint(`Player {Player} is not in the server - updating datastore`)
		local Store = Core.getStore(storeName)
		local _, amount = Store:GetEntry(userId)
		setPlayerEntry(Player, storeName, amount + newAmount)
		return amount + newAmount
	end
end

--- Increments a players data from its newest entry and returns the new amount, 0 if failed
--- @param Player ValidPlayer the player to get the UserId of
--- @param storeName ValidStores the name of the store to get
--- @param keyName string the name of the key to increment
--- @param incrementAmount number the amount to increment the data by
--- @return newAmount number the new amount after incrementing
local function incrementNewestEntry(
	Player: ValidPlayer,
	storeName: ValidStores,
	keyName: string,
	incrementAmount: number
): number
	yieldToLoad()

	local userId = getSafeUserId(Player)
	local isInServer = playerInServer(userId)
	local servedStore = storeIsServed(storeName)

	if isInServer and servedStore then
		return incrementPlayerStat(Player, storeName, keyName, incrementAmount)
	else
		return incrementPlayerEntryData(Player, storeName, keyName, incrementAmount)
	end
end

--- Returns a table entry from a store when the entry is dictionary-shaped.
--- @param Player ValidPlayer a player id or object
--- @param storeName ValidStores the store to inspect
--- @return {[string]: ValidDatastoreValue}? tableEntry the table entry if it exists
local function getPlayerTableEntry(Player: ValidPlayer, storeName: ValidStores)
	if storeIsServed(storeName) then
		warn(`Store {storeName} is served and does not expose table-backed data`)
		return nil
	end

	local entry = getNewestEntry(Player, storeName)
	if type(entry) ~= "table" then
		warn(`Store {storeName} does not contain table data`)
		return nil
	end

	return entry
end

--- Sets an entire table entry in a cold store.
--- @param Player ValidPlayer a player id or object
--- @param storeName ValidStores the store to update
--- @param newTable {[string]: ValidDatastoreValue} the table to store
--- @return boolean success whether it was able to be done
local function setPlayerTableEntry(
	Player: ValidPlayer,
	storeName: ValidStores,
	newTable: { [string]: ValidDatastoreValue }
): boolean
	if storeIsServed(storeName) then
		warn(`Store {storeName} is served and cannot be replaced with a table entry`)
		return false
	end

	return setPlayerEntry(Player, storeName, newTable)
end

--- Returns a key from a table-backed store entry.
--- @param Player ValidPlayer a player id or object
--- @param storeName ValidStores the store to inspect
--- @param dataKey string the key to retrieve
--- @return ValidDatastoreValue? value the value if it exists
local function getPlayerTableEntryData(Player: ValidPlayer, storeName: ValidStores, dataKey: string)
	local entry = getPlayerTableEntry(Player, storeName)
	if not entry then
		return nil
	end

	if entry[dataKey] == nil then
		warn(`Key {dataKey} is not a valid key for the entry`)
		return nil
	end

	return entry[dataKey]
end

--- Sets a key within a table-backed store entry.
--- @param Player ValidPlayer a player id or object
--- @param storeName ValidStores the store to update
--- @param dataKey string the key to update
--- @param newDataValue ValidDatastoreValue the value to store
--- @return boolean success whether it was able to be done
local function setPlayerTableEntryData(
	Player: ValidPlayer,
	storeName: ValidStores,
	dataKey: string,
	newDataValue: ValidDatastoreValue
): boolean
	if storeIsServed(storeName) then
		warn(`Store {storeName} is served and cannot use table-edit helpers`)
		return false
	end

	return updateNewestEntryData(Player, storeName, dataKey, newDataValue)
end

--- Increments a number inside a table-backed store entry.
--- @param Player ValidPlayer a player id or object
--- @param storeName ValidStores the store to update
--- @param dataKey string the key to increment
--- @param incrementAmount number the amount to add
--- @return number amount the new amount
local function incrementPlayerTableEntryData(
	Player: ValidPlayer,
	storeName: ValidStores,
	dataKey: string,
	incrementAmount: number
): number
	if storeIsServed(storeName) then
		warn(`Store {storeName} is served and cannot use table-edit helpers`)
		return 0
	end

	return incrementNewestEntry(Player, storeName, dataKey, incrementAmount)
end

--[[----------------------------------------------------------------------------------
	INVENTORY FUNCTIONS
	High-level helpers for owned items, loadouts, and active loadout.
]]
----------------------------------------------------------------------------------

export type PlayerLoadout = {
	[string]: { string },
}

export type PlayerLoadouts = {
	[string]: PlayerLoadout,
}

export type PlayerInventory = {
	_version: string,
	_served: boolean,
	OwnedItems: { string },
	Loadouts: PlayerLoadouts,
	ActiveLoadout: string,
}

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end

	local copied = {}
	for key, innerValue in pairs(value) do
		copied[key] = deepCopy(innerValue)
	end

	return copied
end

local function getDefaultInventoryTemplate(): PlayerInventory
	local scheme = Schema.getSchemaForStore("Inventory")
	return deepCopy(scheme) :: PlayerInventory
end

local function resetPlayerLoadoutsToDefault(Player: ValidPlayer): boolean
	local inventoryEntry = getNewestEntry(Player, "Inventory")
	if type(inventoryEntry) ~= "table" then
		warn("Could not reset inventory loadouts - entry is malformed")
		return false
	end

	local defaults = getDefaultInventoryTemplate()
	inventoryEntry._version = defaults._version
	inventoryEntry.Loadouts = deepCopy(defaults.Loadouts)
	inventoryEntry.ActiveLoadout = defaults.ActiveLoadout

	return setPlayerEntry(Player, "Inventory", inventoryEntry)
end

local function ensureInventoryLoadoutVersion(Player: ValidPlayer): boolean
	local inventoryEntry = getNewestEntry(Player, "Inventory")
	if type(inventoryEntry) ~= "table" then
		warn("Inventory entry is malformed", type(inventoryEntry))
		return false
	end

	local defaults = getDefaultInventoryTemplate()
	if inventoryEntry._version ~= defaults._version then
		debugWarn("Inventory version mismatch detected, resetting loadouts to defaults")
		return resetPlayerLoadoutsToDefault(Player)
	end

	if type(inventoryEntry.Loadouts) ~= "table" or type(inventoryEntry.ActiveLoadout) ~= "string" then
		debugWarn("Inventory loadout structure is malformed, resetting loadouts to defaults")
		return resetPlayerLoadoutsToDefault(Player)
	end

	return true
end

--- Returns the full inventory entry for a player.
--- @param Player ValidPlayer player id or object
--- @return PlayerInventory? inventory the player's inventory entry
local function getAllPlayerInventory(Player: ValidPlayer): PlayerInventory?
	if not ensureInventoryLoadoutVersion(Player) then
		return nil
	end

	return getNewestEntry(Player, "Inventory") :: PlayerInventory?
end

--- Returns all owned item ids for a player.
--- @param Player ValidPlayer player id or object
--- @return {string} ownedItems list of owned item ids
local function getPlayerOwnedItems(Player: ValidPlayer): { string }
	local inventory = getAllPlayerInventory(Player)
	if not inventory or type(inventory.OwnedItems) ~= "table" then
		return {}
	end

	return inventory.OwnedItems
end

--- Returns true if a player owns a specific item id.
--- @param Player ValidPlayer player id or object
--- @param itemId string the item id to check
--- @return boolean owns whether the item is owned
local function playerOwnsItem(Player: ValidPlayer, itemId: string): boolean
	if itemId == "" then
		return false
	end

	local ownedItems = getPlayerOwnedItems(Player)
	return table.find(ownedItems, itemId) ~= nil
end

--- Adds an item id to a player's owned items list.
--- @param Player ValidPlayer player id or object
--- @param itemId string the item id to add
--- @return boolean success whether the operation succeeded
local function addPlayerOwnedItem(Player: ValidPlayer, itemId: string): boolean
	if itemId == "" then
		warn("Cannot add empty itemId to owned items")
		return false
	end

	if not ensureInventoryLoadoutVersion(Player) then
		return false
	end

	local ownedItems = getPlayerOwnedItems(Player)
	if table.find(ownedItems, itemId) then
		return true
	end

	table.insert(ownedItems, itemId)
	return setPlayerTableEntryData(Player, "Inventory", "OwnedItems", ownedItems)
end

--- Removes an item id from a player's owned items list.
--- @param Player ValidPlayer player id or object
--- @param itemId string the item id to remove
--- @return boolean success whether the operation succeeded
local function removePlayerOwnedItem(Player: ValidPlayer, itemId: string): boolean
	if itemId == "" then
		warn("Cannot remove empty itemId from owned items")
		return false
	end

	if not ensureInventoryLoadoutVersion(Player) then
		return false
	end

	local ownedItems = getPlayerOwnedItems(Player)
	local itemIndex = table.find(ownedItems, itemId)
	if not itemIndex then
		return true
	end

	table.remove(ownedItems, itemIndex)
	return setPlayerTableEntryData(Player, "Inventory", "OwnedItems", ownedItems)
end

--- Returns the full loadouts table.
--- @param Player ValidPlayer player id or object
--- @return PlayerLoadouts? loadouts the player's loadout map
local function getPlayerLoadouts(Player: ValidPlayer): PlayerLoadouts?
	local inventory = getAllPlayerInventory(Player)
	if not inventory then
		return nil
	end

	return inventory.Loadouts
end

--- Returns one named loadout.
--- @param Player ValidPlayer player id or object
--- @param loadoutName string the loadout name
--- @return PlayerLoadout? loadout the requested loadout
local function getPlayerLoadout(Player: ValidPlayer, loadoutName: string): PlayerLoadout?
	if loadoutName == "" then
		return nil
	end

	local loadouts = getPlayerLoadouts(Player)
	if not loadouts then
		return nil
	end

	return loadouts[loadoutName]
end

--- Sets or replaces a named loadout.
--- @param Player ValidPlayer player id or object
--- @param loadoutName string the loadout name
--- @param loadoutData PlayerLoadout the full loadout payload
--- @return boolean success whether the operation succeeded
local function setPlayerLoadout(Player: ValidPlayer, loadoutName: string, loadoutData: PlayerLoadout): boolean
	if loadoutName == "" then
		warn("Cannot set loadout with empty name")
		return false
	end

	if not ensureInventoryLoadoutVersion(Player) then
		return false
	end

	local userId = getSafeUserId(Player)
	local store = Core.getStore("Inventory")
	return store:SetNestedEntry(userId, { "Loadouts", loadoutName }, loadoutData)
end

--- Retrieves a nested entry inside a named loadout.
--- @param Player ValidPlayer player id or object
--- @param loadoutName string the loadout name
--- @param entryPath {ValidDatastoreKey} nested path inside the loadout
--- @return ValidDatastoreValue? value the requested value
local function getPlayerLoadoutEntry(
	Player: ValidPlayer,
	loadoutName: string,
	entryPath: { ValidDatastoreKey }
): ValidDatastoreValue?
	if loadoutName == "" or #entryPath == 0 then
		return nil
	end

	if not ensureInventoryLoadoutVersion(Player) then
		return nil
	end

	local userId = getSafeUserId(Player)
	local store = Core.getStore("Inventory")
	local fullPath = { "Loadouts", loadoutName }
	for _, pathPart in ipairs(entryPath) do
		table.insert(fullPath, pathPart)
	end

	return store:GetNestedEntry(userId, fullPath)
end

--- Sets a nested entry inside a named loadout.
--- @param Player ValidPlayer player id or object
--- @param loadoutName string the loadout name
--- @param entryPath {ValidDatastoreKey} nested path inside the loadout
--- @param newValue ValidDatastoreValue value to write
--- @return boolean success whether the operation succeeded
local function setPlayerLoadoutEntry(
	Player: ValidPlayer,
	loadoutName: string,
	entryPath: { ValidDatastoreKey },
	newValue: ValidDatastoreValue
): boolean
	if loadoutName == "" or #entryPath == 0 then
		warn("Cannot set loadout entry with empty name or path")
		return false
	end

	if not ensureInventoryLoadoutVersion(Player) then
		return false
	end

	local userId = getSafeUserId(Player)
	local store = Core.getStore("Inventory")
	local fullPath = { "Loadouts", loadoutName }
	for _, pathPart in ipairs(entryPath) do
		table.insert(fullPath, pathPart)
	end

	return store:SetNestedEntry(userId, fullPath, newValue)
end

--- Returns the active loadout name.
--- @param Player ValidPlayer player id or object
--- @return string? activeLoadout current active loadout name
local function getPlayerActiveLoadout(Player: ValidPlayer): string?
	if not ensureInventoryLoadoutVersion(Player) then
		return nil
	end

	local activeLoadout = getNewestEntryData(Player, "Inventory", "ActiveLoadout")
	if type(activeLoadout) ~= "string" then
		return nil
	end

	return activeLoadout
end

--- Sets the active loadout name.
--- @param Player ValidPlayer player id or object
--- @param loadoutName string the loadout name to activate
--- @return boolean success whether the operation succeeded
local function setPlayerActiveLoadout(Player: ValidPlayer, loadoutName: string): boolean
	if loadoutName == "" then
		warn("Cannot set empty active loadout")
		return false
	end

	if not ensureInventoryLoadoutVersion(Player) then
		return false
	end

	if not getPlayerLoadout(Player, loadoutName) then
		warn(`Loadout '{loadoutName}' does not exist`)
		return false
	end

	return setPlayerTableEntryData(Player, "Inventory", "ActiveLoadout", loadoutName)
end

